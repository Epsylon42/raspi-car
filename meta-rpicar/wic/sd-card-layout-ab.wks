part /boot --size 100M --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4096
part / --size 400M --source rootfs --ondisk mmcblk0 --fstype=ext4 --label root --align 4096
part --size 400M --source rootfs --ondisk mmcblk0 --fstype=ext4 --label root2 --align 4096
part /etc/NetworkManager/system-connections --source rootfs --change-directory=etc/NetworkManager/system-connections --size 10M --ondisk mmcblk0 --fstype=ext4 --label data --align 4096
